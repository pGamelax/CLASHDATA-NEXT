{
  "name": "@clashdata/backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "db:generate": "bunx --bun prisma generate --schema=./prisma/schema.prisma",
    "db:push": "bunx --bun prisma db push",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:studio": "bunx --bun prisma studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/openapi": "^1.4.14",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.0.0",
    "@prisma/client-runtime-utils": "^7.3.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@tanstack/react-table": "^8.21.3",
    "@types/pg": "^8.16.0",
    "better-auth": "^1.0.0",
    "bullmq": "^5.0.0",
    "elysia": "^1.1.20",
    "ioredis": "^5.3.2",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "resend": "^6.9.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.14.12",
    "@types/qrcode": "^1.5.6",
    "prisma": "^7.3.0"
  }
}
