// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// Better Auth tables
model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("user")
  banned        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accounts      Account[]
  sessions      Session[]
  members       Member[]
  invites       Invite[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  accountId         String
  providerId        String
  accessToken       String? @db.Text
  refreshToken      String? @db.Text
  idToken           String? @db.Text
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  password          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("session")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model Organization {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  logo          String?
  metadata      Json?
  subscription  Subscription?
  pixPayments   PixPayment[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  members       Member[]
  clans         Clan[]
  invites       Invite[]

  @@map("organization")
}

model Clan {
  id             String       @id @default(cuid())
  organizationId String
  tag            String       @unique // Tag do clan do Clash of Clans (ex: #2GPV299QG) - única globalmente
  name           String
  description    String?
  badgeUrls      Json?        // URLs dos badges (small, medium, large)
  clanLevel      Int?
  clanPoints     Int?
  members        Int?
  metadata       Json?        // Dados adicionais do clan
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("clan")
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("member")
}

model Player {
  id        String   @id @default(cuid())
  tag       String   @unique
  name      String
  trophies  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logs      LegendLeagueLog[]

  @@index([tag])
  @@map("player")
}

model LegendLeagueLog {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type        String   // "attack" ou "defense"
  trophiesChange Int   // Mudança de troféus (positivo para attack, negativo para defense)
  previousTrophies Int // Troféus anteriores
  currentTrophies  Int // Troféus atuais
  clanTag     String?  // Tag do clan atual do jogador
  createdAt   DateTime @default(now())

  @@index([playerId])
  @@index([createdAt])
  @@map("legend_league_log")
}

// Dynamic plan configuration
model Plan {
  id                   String   @id @default(cuid())
  key                  String   @unique   // e.g. "MESTRE", "CAMPEAO", or any custom key
  name                 String
  description          String?
  monthlyPrice         Int               // em centavos
  quarterlyPrice       Int               // em centavos (com desconto)
  yearlyPrice          Int               // em centavos (com desconto)
  originalQuarterlyPrice Int?            // em centavos (sem desconto)
  originalYearlyPrice    Int?            // em centavos (sem desconto)
  maxClans             Int
  maxInvites           Int
  icon                 String   @default("shield")  // nome do ícone (shield, crown, zap, star...)
  color                String   @default("blue")    // tema de cor (blue, yellow, purple, green...)
  features             String[]
  isPopular            Boolean  @default(false)
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("plan")
}

// Subscription models
enum SubscriptionStatus {
  TRIAL       // Free trial de 3 dias
  ACTIVE      // Assinatura ativa e paga
  CANCELLED   // Assinatura cancelada
  EXPIRED     // Assinatura expirada
}

model Subscription {
  id                String             @id @default(cuid())
  organizationId    String             @unique
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan              String
  status            SubscriptionStatus @default(TRIAL)
  period            String?            @default("monthly") // monthly, quarterly, yearly
  trialEndsAt       DateTime?          // Data de término do trial (3 dias após criação)
  currentPeriodEnd  DateTime?          // Data de término do período atual
  cancelAtPeriodEnd Boolean            @default(false)
  pendingPlan       String?            // Plano agendado para o fim do período (downgrade)
  paymentProvider   String?            @default("syncpay")
  paymentProviderId String?
  pixPayments       PixPayment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([organizationId])
  @@index([status])
  @@map("subscription")
}

enum PixPaymentStatus {
  PENDING    // Aguardando pagamento
  PAID       // Pago
  EXPIRED    // QR code expirado sem pagamento
  CANCELLED  // Cancelado
}

model PixPayment {
  id              String           @id @default(cuid())
  organizationId  String
  subscriptionId  String
  subscription    Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount          Int              // em centavos
  plan            String
  period          String           // monthly, quarterly, yearly
  status          PixPaymentStatus @default(PENDING)
  upgradeOnly     Boolean          @default(false) // Se true, só muda o plano (não o currentPeriodEnd)
  syncpayId       String?          @unique // idTransaction no SyncPay
  pixCode         String?          @db.Text // Código copia e cola
  pixQrCodeBase64 String?          @db.Text // QR code em base64
  pixExpiresAt    DateTime?        // Expiração do QR code (24h)
  periodFrom      DateTime?        // Início do período coberto
  periodTo        DateTime?        // Fim do período coberto
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([status])
  @@index([syncpayId])
  @@map("pix_payment")
}

model SeasonEndDate {
  id          String           @id @default(cuid())
  date        String           // "2026-03-19" format
  label       String?          // "Março 2026"
  status      String           @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  jobId       String?          // BullMQ job ID
  capturedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  snapshots   SeasonSnapshot[]

  @@index([date])
  @@map("season_end_date")
}

model SeasonSnapshot {
  id              String        @id @default(cuid())
  seasonEndDateId String
  seasonEndDate   SeasonEndDate @relation(fields: [seasonEndDateId], references: [id], onDelete: Cascade)
  clanTag         String
  clanName        String
  organizationId  String
  players         Json          // Array of { rank, name, tag, trophies, role, expLevel }
  capturedAt      DateTime      @default(now())

  @@unique([seasonEndDateId, clanTag])
  @@index([clanTag])
  @@index([seasonEndDateId])
  @@map("season_snapshot")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcement")
}

model Invite {
  id             String       @id @default(cuid())
  organizationId String
  userId         String       // Usuário convidado
  invitedBy      String       // ID do usuário que enviou o convite
  status         String       @default("PENDING") // PENDING, ACCEPTED, REJECTED, EXPIRED
  expiresAt      DateTime?    // Data de expiração do convite (opcional)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("invite")
}
