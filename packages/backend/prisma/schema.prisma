// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// Better Auth tables
model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("user")
  banned        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accounts      Account[]
  sessions      Session[]
  ownedClans    Clan[]   @relation("OwnedClans")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  accountId         String
  providerId        String
  accessToken       String? @db.Text
  refreshToken      String? @db.Text
  idToken           String? @db.Text
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  password          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("session")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model Clan {
  id             String        @id @default(cuid())
  ownerId        String
  owner          User          @relation("OwnedClans", fields: [ownerId], references: [id], onDelete: Cascade)
  tag            String        @unique // Tag do clan do Clash of Clans (ex: #2GPV299QG)
  name           String
  description    String?
  badgeUrls      Json?
  clanLevel      Int?
  clanPoints     Int?
  members        Int?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscription   Subscription?
  pixPayments    PixPayment[]

  @@index([ownerId])
  @@map("clan")
}

model Player {
  id        String   @id @default(cuid())
  tag       String   @unique
  name      String
  trophies  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logs      LegendLeagueLog[]

  @@index([tag])
  @@map("player")
}

model LegendLeagueLog {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type        String   // "attack" ou "defense"
  trophiesChange Int
  previousTrophies Int
  currentTrophies  Int
  clanTag     String?
  createdAt   DateTime @default(now())

  @@index([playerId])
  @@index([createdAt])
  @@map("legend_league_log")
}

// Dynamic plan configuration
model Plan {
  id                   String   @id @default(cuid())
  key                  String   @unique
  name                 String
  description          String?
  monthlyPrice         Int
  quarterlyPrice       Int
  yearlyPrice          Int
  originalQuarterlyPrice Int?
  originalYearlyPrice    Int?
  icon                 String   @default("shield")
  color                String   @default("blue")
  features             String[]
  isPopular            Boolean  @default(false)
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("plan")
}

// Subscription models
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
  EXPIRED
}

model Subscription {
  id                String             @id @default(cuid())
  clanId            String             @unique
  clan              Clan               @relation(fields: [clanId], references: [id], onDelete: Cascade)
  plan              String
  status            SubscriptionStatus @default(TRIAL)
  period            String?            @default("monthly")
  trialEndsAt       DateTime?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  pendingPlan       String?
  paymentProvider   String?            @default("syncpay")
  paymentProviderId String?
  pixPayments       PixPayment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([clanId])
  @@index([status])
  @@map("subscription")
}

enum PixPaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

model PixPayment {
  id              String           @id @default(cuid())
  clanId          String
  clan            Clan             @relation(fields: [clanId], references: [id], onDelete: Cascade)
  subscriptionId  String
  subscription    Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount          Int
  plan            String
  period          String
  status          PixPaymentStatus @default(PENDING)
  upgradeOnly     Boolean          @default(false)
  externalId      String?          @unique
  pixCode         String?          @db.Text
  pixQrCodeBase64 String?          @db.Text
  pixExpiresAt    DateTime?
  periodFrom      DateTime?
  periodTo        DateTime?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([clanId])
  @@index([subscriptionId])
  @@index([status])
  @@index([externalId])
  @@map("pix_payment")
}

enum PendingClanPaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

model PendingClanPayment {
  id              String                   @id @default(cuid())
  userId          String
  clanTag         String
  clanName        String
  plan            String
  period          String
  amount          Int
  status          PendingClanPaymentStatus @default(PENDING)
  externalId      String?                  @unique
  pixCode         String?                  @db.Text
  pixQrCodeBase64 String?                  @db.Text
  pixExpiresAt    DateTime?
  paidAt          DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([userId])
  @@index([externalId])
  @@index([status])
  @@map("pending_clan_payment")
}

model SeasonEndDate {
  id          String           @id @default(cuid())
  date        String
  label       String?
  status      String           @default("PENDING")
  jobId       String?
  capturedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  snapshots   SeasonSnapshot[]

  @@index([date])
  @@map("season_end_date")
}

model SeasonSnapshot {
  id              String        @id @default(cuid())
  seasonEndDateId String
  seasonEndDate   SeasonEndDate @relation(fields: [seasonEndDateId], references: [id], onDelete: Cascade)
  clanTag         String
  clanName        String
  clanId          String        // ID do clan no sistema
  players         Json
  capturedAt      DateTime      @default(now())

  @@unique([seasonEndDateId, clanTag])
  @@index([clanTag])
  @@index([seasonEndDateId])
  @@map("season_snapshot")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcement")
}
